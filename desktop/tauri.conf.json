{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soundcheck",
  "version": "../package.json",
  "identifier": "com.adrianeyre.soundcheck",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5145",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Soundcheck",
        "width": 1280,
        "height": 900,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/adrianeyre/soundcheck/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

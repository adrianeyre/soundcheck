{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "unicorn",
    "oxc",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "engine/pkg/**",
    "**/dist/**",
    "target/**"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css",
          "@testing-library/jest-dom/vitest",
          "./text-codec-polyfill"
        ]
      }
    ]
  }
}
